{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/loading",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/loading/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/loading/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_original",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_original/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/_original/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/build.py",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/server.py",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/studio-(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/fuc/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fuc/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
